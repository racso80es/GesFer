{
  "name": "calma-desktop",
  "version": "1.0.0",
  "description": "GesFer Development Orchestrator",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/kaizen-check.js ../../../CONSTITUTION.md",
    "build": "tsc && vite build && electron-builder",
    "build:fast": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:node": "vitest run -c vitest.config.node.ts",
    "test:node:coverage": "vitest run -c vitest.config.node.ts --coverage",
    "test:e2e": "playwright test",
    "e2e": "npm run build:fast && playwright test"
  },
  "dependencies": {
    "@iota/sdk": "^1.1.6",
    "@iota/sdk-wasm": "^1.1.3",
    "clsx": "^2.1.0",
    "electron-store": "^8.1.0",
    "inversify": "^7.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.0.5",
    "wait-on": "^7.2.0"
  }
}
