#!/bin/sh
# Pre-commit hook - Security Audit Automation
# Enforces the Commit Skill (Token + Unit Tests)

echo "🔒 [SECURITY AUDIT] Validating Commit..."

# Execute the Commit Skill script
if [ -f "scripts/skills/commit-skill.sh" ]; then
    bash scripts/skills/commit-skill.sh
    EXIT_CODE=$?
else
    echo "❌ ERROR: scripts/skills/commit-skill.sh not found!"
    exit 1
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ COMMIT BLOCKED by Security Audit."
    exit 1
fi

exit 0
