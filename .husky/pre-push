#!/bin/sh
# Pre-push hook - Security Audit Automation
# Enforces the PR Skill (Token + All Tests)

echo "🔒 [SECURITY AUDIT] Validating Push/PR..."

# Execute the PR Skill script
if [ -f "scripts/skills/pr-skill.sh" ]; then
    bash scripts/skills/pr-skill.sh
    EXIT_CODE=$?
else
    echo "❌ ERROR: scripts/skills/pr-skill.sh not found!"
    exit 1
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo "❌ PUSH BLOCKED by Security Audit."
    exit 1
fi

exit 0
