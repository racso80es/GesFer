{
  "project": "GesFer",
  "task_start_sequence": [
    "Fase 0: Declaración de Ámbito"
  ],
  "task_phases": [
    {
      "phase": 0,
      "name": "Fase 0: Declaración de Ámbito",
      "description": "Tekton debe indicar explícitamente qué parte del proyecto va a observar (API, Cliente, Infra, Cross) antes de cualquier análisis o escritura."
    }
  ],
  "paths": {
    "api": "src/Product/Back/Api",
    "client": "Cliente",
    "seeds": "src/Product/Back/Infrastructure/Data/Seeds/demo-data.json",
    "tests": "src/Product/Back/IntegrationTests"
  },
  "manifesto": "Tekton/Configuration/MANIFESTO.md",
  "rules": "Tekton/Rules/GOLDEN_RULES.md",
  "git_policy": "no_master_commit",
  "tools": {
    "tae": {
      "start": {
        "script": "Tekton/Tools/Start-Task.ps1",
        "invocation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File Tekton/Tools/Start-Task.ps1"
      },
      "close": {
        "script": "Tekton/Tools/Close-Task.ps1",
        "invocation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File Tekton/Tools/Close-Task.ps1"
      }
    }
  },
  "task_triggers": {
    "start_task": {
      "sencilla": {
        "commandTemplate": "<tae.start> -Name \"{Name}\" -Scope \"{Scope}\" -Type \"Sencilla\" -OutputFormat Json -PlanOnly"
      },
      "normal": {
        "commandTemplate": "<tae.start> -Name \"{Name}\" -Scope \"{Scope}\" -Type \"Normal\" -OutputFormat Json -PlanOnly"
      },
      "compleja": {
        "commandTemplate": "<tae.start> -Name \"{Name}\" -Scope \"{Scope}\" -Type \"Compleja\" -OutputFormat Json -PlanOnly"
      }
    }
  }
}

